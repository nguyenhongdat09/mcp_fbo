<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
  AGENT GUIDE — Report controller báo cáo xoay.
  * Nhiều <form> = nhiều mẫu in (010/020 PDF .rpt, 110/120 Excel .xlsx) —
    file in thiết kế ngoài. &f; trên form ngoại tệ thêm nút đổi tiền tệ.
  * pv_* = header text của cột PIVOT động (map vào file in); h_* = header
    cột tĩnh. Đổi theo cột thật của {{proc}}.
============================================================================ -->
<!DOCTYPE report [
	<!ENTITY b SYSTEM ".\Include\BaseCurrency.xml">
	<!ENTITY f SYSTEM ".\Include\ForeignCurrency.xml">
	<!ENTITY s SYSTEM ".\Include\Separate.xml">

	<!ENTITY p "../images/pdf.gif">
	<!ENTITY e "../images/excel.gif">
]>

<report xmlns="urn:schemas-fast-com:data-report">
	<forms>
		<form id="010" reportFile="{{controller}}_01" templateFile="" commandArgument="Pdf" urlImage="&p;">
			<header v="{{title_v}} — mẫu 1" e="{{title_e}} — form 1"></header>
			<download>
				<header v="{{title_v}} — mẫu 1" e="{{title_e}} — form 1"/>
			</download>
		</form>

		<form id="020" reportFile="{{controller}}_02" templateFile="" commandArgument="Pdf">
			<header v="{{title_v}} — mẫu 2" e="{{title_e}} — form 2"></header>
			<download>
				<header v="{{title_v}} — mẫu 2" e="{{title_e}} — form 2"/>
			</download>
		</form>

		&s;

		<form id="110" reportFile="" templateFile="{{controller}}_01" commandArgument="Excel" urlImage="&e;">
			<header v="{{title_v}} — mẫu 1" e="{{title_e}} — form 1"></header>
			<download>
				<header v="{{title_v}} — mẫu 1" e="{{title_e}} — form 1"/>
			</download>
		</form>
		<form id="120" reportFile="" templateFile="{{controller}}_02" commandArgument="Excel">
			<header v="{{title_v}} — mẫu 2" e="{{title_e}} — form 2"></header>
			<download>
				<header v="{{title_v}} — mẫu 2" e="{{title_e}} — form 2"/>
			</download>
		</form>
	</forms>

	<fields>
		<field name="title" type="String">
			<header v="{{title_v_upper}}" e="{{title_e_upper}}"/>
		</field>
		<field name="h_ngay" type="String">
			<header v="Ngày:" e="Date:"/>
		</field>
		<field name="h_name_string_1" type="String">
			<header v="Mã" e="Code"/>
		</field>
		<field name="h_name_string_2" type="String">
			<header v="Tên" e="Name"/>
		</field>
		<field name="h_tong_cong" type="String">
			<header v="Tổng cộng" e="Total"/>
		</field>
		<field name="pv_name_decimal_1" type="String">
			<header v=" Số tiền 1 " e=" Amount 1 "/>
		</field>
		<field name="pv_name_decimal_2" type="String">
			<header v=" Số tiền 2 " e=" Amount 2 "/>
		</field>
		<field name="pv_name_decimal_3" type="String">
			<header v=" Số tiền 3 " e=" Amount 3 "/>
		</field>
	</fields>
</report>
