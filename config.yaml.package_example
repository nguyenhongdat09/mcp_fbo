# FastBusiness MCP Server Configuration

server:
  name: "fastbusiness-xml-context"
  version: "1.0.0"

# Database paths
# Priority: 1. Environment variables  2. This config  3. Default paths
database:
  # Để trống hoặc relative path - sẽ được override bởi environment variable
  lmdb_path: "data/fields_lmdb"

# Resource paths
paths:
  # Relative path từ package folder
  knowledge_base: "knowledge_base"

logging:
  level: "INFO"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
